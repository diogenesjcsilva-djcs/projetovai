NODE_ENV=development
API_PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001

# Desenvolvimento local somente. Em produção, use secrets gerenciados.
DATABASE_URL=postgresql://transporte:transporte_dev_only@localhost:5432/transporte
REDIS_URL=redis://localhost:6379

# SMS: adapter HTTP JSON genérico (configurar endpoint compatível com o contrato em docs/sprint-2-data-auth.md).
SMS_API_URL=
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# Segredos de autenticação: gere valores aleatórios com pelo menos 32 caracteres.
# Ex.: openssl rand -hex 32. Nunca reutilize estes exemplos em produção.
AUTH_OTP_HMAC_SECRET=
JWT_ACCESS_SECRET=
JWT_ISSUER=projetovai-api
JWT_AUDIENCE=projetovai-apps
MAPS_PROVIDER=
MAPS_API_KEY=
PAYMENTS_PROVIDER=
PAYMENTS_API_KEY=
