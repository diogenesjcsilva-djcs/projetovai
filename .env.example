NODE_ENV=development
API_PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001

# Desenvolvimento local somente. Em produção, use secrets gerenciados.
DATABASE_URL=postgresql://projetovai_owner:npg_7A9EBcvartiq@ep-restless-sun-b6reijmb-pooler.c-2.sa-east-1.aws.neon.tech/projetovai?sslmode=require&channel_binding=require
REDIS_URL=redis://localhost:6379

# SMS via Zenvia REST API. SMS_API_KEY é o token X-API-TOKEN.
# Ative o canal SMS e configure o sender ID na conta Zenvia antes de testar.
SMS_PROVIDER=zenvia
SMS_API_KEY=
SMS_SENDER_ID=

# Segredos de autenticação: gere valores aleatórios com pelo menos 32 caracteres.
# Ex.: openssl rand -hex 32. Nunca reutilize estes exemplos em produção.
AUTH_OTP_HMAC_SECRET=
JWT_ACCESS_SECRET=
JWT_ISSUER=projetovai-api
JWT_AUDIENCE=projetovai-apps
MAPS_PROVIDER=
MAPS_API_KEY=
PAYMENTS_PROVIDER=
PAYMENTS_API_KEY=
