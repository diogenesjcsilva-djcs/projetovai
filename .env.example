NODE_ENV=development
API_PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001

# Desenvolvimento local somente. Use secrets gerenciados fora deste arquivo.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/projetovai
REDIS_URL=redis://localhost:6379

# SMSGo: use a chave de teste em homologação; nunca registre segredos reais aqui.
SMS_PROVIDER=smsgo
SMSGO_API_KEY=

# Segredos de autenticação: gere valores aleatórios com pelo menos 32 caracteres.
AUTH_OTP_HMAC_SECRET=
JWT_ACCESS_SECRET=
JWT_ISSUER=projetovai-api
JWT_AUDIENCE=projetovai-apps
MAPS_PROVIDER=
MAPS_API_KEY=
PAYMENTS_PROVIDER=
PAYMENTS_API_KEY=
